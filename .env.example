# This pipeline needs no API keys, tokens, or model credentials at all.
# It is 100% deterministic code: corpus indexing, French number/date
# parsing, and evidence-based routing — no LLM call, no network request,
# anywhere in archean/ or scripts/ (verified by
# tests/test_route.py::test_route_py_imports_nothing_fuzzy_or_networked and
# by a corpus-wide grep audit, see DISCOVERY.md's closing section).
#
# The one environment variable the code reads is a local path override, not
# a secret — set it only if you keep the reference challenge clone
# (github.com/takeovers-ai/engineering-challenges) somewhere other than
# alongside this repository.

# Path to the engineering-challenges clone (containing data/, challenges/,
# tools/). Defaults to ../engineering-challenges relative to this repo.
ARCHEAN_CHALLENGE_ROOT=
